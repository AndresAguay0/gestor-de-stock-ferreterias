PORT=4000

# [Obligatorio] Minimo 32 caracteres. Generar con: node -p "crypto.randomBytes(48).toString('hex')"
JWT_SECRET=

# [Opcional] (La base ya se crea por defecto en server/database.sqlite)
# DB_PATH=/ruta/nueva/database.sqlite

# [Opcional] Duración de la sesión (por defecto 12h)
# JWT_EXPIRES_IN=12h

# [Opcional] Cantidad de proxies delante del servidor
# TRUST_PROXY=0

# [Opcional] Límite de intentos fallidos: ventana en minutos (15) y máximos por login (10) y cambio de contraseña (5)
# RATE_LIMIT_WINDOW_MINUTES=15
# LOGIN_MAX_ATTEMPTS=10
# CHANGE_PASSWORD_MAX_ATTEMPTS=5