PORT=4000

# [Opcional] (La base ya se crea por defecto en server/database.sqlite)
# DB_PATH=/ruta/nueva/database.sqlite

# [Obligatorio] Minimo 32 caracteres. Generar con: node -p "crypto.randomBytes(48).toString('hex')"
JWT_SECRET=

# [Opcional] Duración de la sesión (por defecto 12h)
# JWT_EXPIRES_IN=12h