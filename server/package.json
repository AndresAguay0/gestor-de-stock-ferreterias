{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend del sistema de gestion de stock",
  "license": "MIT",
  "author": "Andres Aguayo, Fabricio Maida, Ailen Villalba",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "migrate:status": "tsx src/db/migrate.ts status"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jose": "6.2.17",
    "sequelize": "6.37.8",
    "sqlite3": "6.0.1",
    "umzug": "3.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
