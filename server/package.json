{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend del sistema de gestion de stock",
  "license": "MIT",
  "author": "Andres Aguayo, Fabricio Maida, Ailen Villalba",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "migrate:status": "tsx src/db/migrate.ts status",
    "migrate:prod": "node dist/db/migrate.js up",
    "create-owner": "tsx src/scripts/create-owner.ts",
    "create-owner:prod": "node dist/scripts/create-owner.js",
    "reset-owner-password": "tsx src/scripts/reset-owner-password.ts",
    "reset-owner-password:prod": "node dist/scripts/reset-owner-password.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "jose": "6.2.17",
    "sequelize": "6.37.8",
    "sqlite3": "6.0.1",
    "umzug": "3.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true,
    "esbuild@0.28.2": true
  }
}
